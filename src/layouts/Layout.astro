---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = "NurseSynapse — AI tools, NCLEX prep & resources for modern nurses",
  description = "NurseSynapse helps nurses find the best AI tools, NCLEX prep courses, and career resources. Real nurse perspective, honest reviews.",
  canonical: canonicalProp,
} = Astro.props;

const canonical = canonicalProp ?? new URL(Astro.url.pathname, "https://nursesynapse.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NurseSynapse" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <rect width="28" height="28" rx="7" fill="url(#lg)"/>
            <defs>
              <linearGradient id="lg" x1="0" y1="0" x2="28" y2="28">
                <stop offset="0%" stop-color="#0d9488"/>
                <stop offset="100%" stop-color="#6366f1"/>
              </linearGradient>
            </defs>
            <text x="5" y="20" font-family="Inter,sans-serif" font-weight="800" font-size="13" fill="white">NS</text>
          </svg>
          <span class="logo-text">NurseSynapse</span>
        </a>
        <nav>
          <a href="/nclex">NCLEX</a>
          <a href="/guides/ai-tools-for-nurses">AI Tools</a>
          <a href="/about">About</a>
        </nav>
        <a href="/nclex" class="cta-btn">Compare Courses</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-logo">NurseSynapse</span>
          <p>Resources for modern nurses. Real experience, honest reviews.</p>
        </div>
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/nclex">NCLEX</a>
          <a href="/guides/ai-tools-for-nurses">AI Tools</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/disclaimer">Affiliate Disclosure</a>
        </div>
        <p class="footer-note">NurseSynapse may earn commissions from affiliate links. Rankings are based on merit, not partnerships. © {new Date().getFullYear()} NurseSynapse</p>
      </div>
    </footer>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0f1117;
        --surface: #16181f;
        --surface2: #1e2029;
        --border: #2a2d3a;
        --border-light: #353848;
        --text: #f1f5f9;
        --text-muted: #8b92a9;
        --text-dim: #555d75;
        --teal: #14b8a6;
        --teal-dim: #0d9488;
        --indigo: #818cf8;
        --indigo-dim: #6366f1;
        --gradient: linear-gradient(135deg, #0d9488, #6366f1);
        --shadow: 0 0 0 1px rgba(255,255,255,0.04), 0 8px 32px rgba(0,0,0,0.4);
        --radius: 12px;
      }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'DM Sans', -apple-system, system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--teal); text-decoration: none; }
      a:hover { color: #5eead4; }

      h1 { font-size: clamp(28px, 5vw, 42px); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; }
      h2 { font-size: clamp(20px, 3vw, 26px); font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
      h3 { font-size: 17px; font-weight: 600; line-height: 1.3; }

      /* HEADER */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 17, 23, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .header-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
        height: 60px;
        display: flex;
        align-items: center;
        gap: 32px;
      }
      .logo { display: flex; align-items: center; gap: 9px; color: var(--text); font-weight: 700; font-size: 16px; }
      .logo:hover { color: var(--text); }
      .logo-text { font-weight: 700; }
      nav { display: flex; gap: 24px; margin-left: 8px; }
      nav a { color: var(--text-muted); font-size: 14px; font-weight: 500; transition: color 0.15s; }
      nav a:hover { color: var(--text); }
      .cta-btn {
        margin-left: auto;
        background: var(--gradient);
        color: white;
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: opacity 0.15s;
      }
      .cta-btn:hover { opacity: 0.85; color: white; }

      /* MAIN */
      main { flex: 1; }

      /* FOOTER */
      footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding: 40px 24px;
        margin-top: 80px;
      }
      .footer-inner { max-width: 1080px; margin: 0 auto; }
      .footer-brand { margin-bottom: 20px; }
      .footer-logo { font-weight: 700; font-size: 15px; display: block; margin-bottom: 6px; }
      .footer-brand p { color: var(--text-muted); font-size: 13px; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; }
      .footer-links a { color: var(--text-muted); font-size: 13px; transition: color 0.15s; }
      .footer-links a:hover { color: var(--text); }
      .footer-note { color: var(--text-dim); font-size: 12px; line-height: 1.6; }

      /* UTILS */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
      }
      .badge-teal { background: rgba(20,184,166,0.12); color: var(--teal); border: 1px solid rgba(20,184,166,0.2); }
      .badge-indigo { background: rgba(129,140,248,0.12); color: var(--indigo); border: 1px solid rgba(129,140,248,0.2); }
      .badge-green { background: rgba(34,197,94,0.12); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }
      .badge-amber { background: rgba(251,191,36,0.12); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
      }

      .page-wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 56px 24px;
      }

      .prose {
        max-width: 68ch;
      }
      .prose p { color: var(--text-muted); margin-bottom: 16px; line-height: 1.75; }
      .prose h2 { color: var(--text); margin: 36px 0 12px; }
      .prose h3 { color: var(--text); margin: 24px 0 8px; }
      .prose ul { padding-left: 20px; color: var(--text-muted); }
      .prose ul li { margin: 6px 0; line-height: 1.7; }
      .prose a { color: var(--teal); }

      @media (max-width: 640px) {
        .header-inner { gap: 16px; }
        nav { gap: 14px; }
        .cta-btn { display: none; }
      }
    </style>
  </body>
</html>
