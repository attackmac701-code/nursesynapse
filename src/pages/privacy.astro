---
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---
<Layout title="Privacy Policy | NurseSynapse" description="NurseSynapse privacy policy.">
  <article>
    <h1>Privacy Policy</h1>
    <p>NurseSynapse does not collect personal data from visitors. We do not use tracking cookies beyond basic analytics.</p>
    <p>Third-party links (affiliate links) may have their own privacy practices. We recommend reviewing the privacy policy of any site you visit through our links.</p>
    <p>This site may use basic analytics (page views) to understand traffic. No personally identifiable information is collected.</p>
    <p>Last updated: May 2025</p>
  </article>
</Layout>
