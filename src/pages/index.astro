---
import Layout from "../layouts/Layout.astro";
export const prerender = true;

const featured = [
  {
    href: "/reviews/uworld-nursing-review",
    badge: "NCLEX Prep",
    badgeClass: "badge-teal",
    title: "UWorld Nursing Review",
    desc: "The gold standard for NCLEX prep. Is it worth the price? A real nurse breaks it down.",
  },
  {
    href: "/reviews/nursing-com-review",
    badge: "Education",
    badgeClass: "badge-indigo",
    title: "Nursing.com Review",
    desc: "Video-based nursing education with a strong community. Full honest review.",
  },
  {
    href: "/guides/ai-tools-for-nurses",
    badge: "AI Tools",
    badgeClass: "badge-green",
    title: "Best AI Tools for Nurses in 2025",
    desc: "From AI charting to clinical decision support — the tools actually worth your time.",
  },
];
---

<Layout>
  <section class="hero">
    <div class="hero-tag">Built by a nurse, for nurses</div>
    <h1>The intersection of nursing and AI — honest resources for modern nurses</h1>
    <p class="hero-sub">
      NCLEX prep comparisons, AI tool reviews, and career resources. No fluff. Real nurse perspective.
    </p>
    <div class="hero-cta">
      <a href="/nclex" class="btn-primary">Compare NCLEX Courses →</a>
      <a href="/guides/ai-tools-for-nurses" class="btn-secondary">AI Tools for Nurses</a>
    </div>
  </section>

  <section class="featured">
    <h2>Featured</h2>
    <div class="card-grid">
      {featured.map(f => (
        <a href={f.href} class="feature-card">
          <span class={`badge ${f.badgeClass}`}>{f.badge}</span>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
          <span class="read-link">Read →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="why">
    <h2>Why NurseSynapse?</h2>
    <div class="why-grid">
      <div class="why-item">
        <span class="why-icon">🩺</span>
        <h3>Real nurse perspective</h3>
        <p>Written by an RN with clinical experience — not a content farm. We know what actually matters at the bedside.</p>
      </div>
      <div class="why-item">
        <span class="why-icon">🤖</span>
        <h3>AI-forward</h3>
        <p>We cover emerging AI tools in healthcare honestly — what helps, what's hype, and what's coming next.</p>
      </div>
      <div class="why-item">
        <span class="why-icon">✅</span>
        <h3>Honest reviews</h3>
        <p>We only recommend tools we'd use ourselves. Affiliate links disclosed. No paid placements hiding as reviews.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { text-align: center; padding: 48px 0 40px; max-width: 680px; margin: 0 auto; }
  .hero-tag { display: inline-block; background: var(--accent-soft); color: var(--accent); border: 1px solid #99f6e4; border-radius: 20px; padding: 4px 14px; font-size: 13px; font-weight: 600; margin-bottom: 20px; }
  .hero h1 { font-size: 36px; }
  .hero-sub { font-size: 18px; color: var(--text-muted); margin: 0 0 28px; }
  .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--accent); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; font-size: 15px; }
  .btn-primary:hover { opacity: 0.9; text-decoration: none; }
  .btn-secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); padding: 12px 24px; border-radius: 8px; font-weight: 600; font-size: 15px; }
  .btn-secondary:hover { border-color: var(--accent); text-decoration: none; }
  .featured { margin-top: 48px; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 16px; }
  .feature-card { display: flex; flex-direction: column; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; text-decoration: none; color: var(--text); transition: border-color 0.15s, box-shadow 0.15s; }
  .feature-card:hover { border-color: var(--accent); box-shadow: var(--shadow); text-decoration: none; }
  .feature-card h3 { margin: 4px 0 0; font-size: 17px; }
  .feature-card p { color: var(--text-muted); font-size: 14px; margin: 0; flex: 1; }
  .read-link { color: var(--accent); font-size: 13px; font-weight: 600; }
  .why { margin-top: 56px; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 16px; }
  .why-item { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
  .why-icon { font-size: 28px; display: block; margin-bottom: 10px; }
  .why-item h3 { margin: 0 0 8px; font-size: 16px; }
  .why-item p { color: var(--text-muted); font-size: 14px; margin: 0; }
</style>
