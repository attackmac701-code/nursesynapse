---
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">Built by a nurse · For nurses</div>
      <h1>Where nursing expertise<br/><span class="gradient-text">meets AI</span></h1>
      <p class="hero-sub">
        Honest NCLEX prep comparisons, AI tool reviews, and career resources —
        written by a working RN, not a content farm.
      </p>
      <div class="hero-actions">
        <a href="/nclex" class="btn-primary">Compare NCLEX Courses →</a>
        <a href="/guides/ai-tools-for-nurses" class="btn-ghost">AI Tools for Nurses</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><span class="stat-num">5+</span><span class="stat-label">Courses reviewed</span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-num">10+</span><span class="stat-label">AI tools tested</span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-num">100%</span><span class="stat-label">Independent reviews</span></div>
      </div>
    </div>
    <div class="hero-glow"></div>
  </section>

  <!-- FEATURES -->
  <section class="features page-wrap">
    <div class="section-label">What we cover</div>
    <h2 class="section-title">Everything a modern nurse needs</h2>
    <div class="feature-grid">
      <a href="/nclex" class="feature-card">
        <div class="feature-icon">📋</div>
        <h3>NCLEX Prep</h3>
        <p>UWorld vs Archer vs Kaplan — ranked and compared by someone who's actually used them.</p>
        <span class="feature-link">See comparisons →</span>
      </a>
      <a href="/guides/ai-tools-for-nurses" class="feature-card">
        <div class="feature-icon">🤖</div>
        <h3>AI Tools</h3>
        <p>AI charting, clinical decision support, scheduling apps — what's actually useful vs. hype.</p>
        <span class="feature-link">Explore tools →</span>
      </a>
      <div class="feature-card coming">
        <div class="feature-icon">💼</div>
        <h3>Career Resources</h3>
        <p>Travel nursing, CE platforms, specialty certifications — guides for every stage of your career.</p>
        <span class="badge badge-amber">Coming soon</span>
      </div>
    </div>
  </section>

  <!-- TOP PICKS -->
  <section class="picks-section">
    <div class="page-wrap">
      <div class="section-label">Top picks</div>
      <h2 class="section-title">Our highest-rated NCLEX courses</h2>
      <div class="picks-list">
        <a href="/reviews/uworld-nursing-review" class="pick-row">
          <div class="pick-rank">#1</div>
          <div class="pick-body">
            <div class="pick-top">
              <span class="pick-name">UWorld Nursing</span>
              <span class="badge badge-teal">Best Overall</span>
            </div>
            <p class="pick-desc">The most realistic NCLEX-style questions available. Unmatched rationales.</p>
          </div>
          <div class="pick-right">
            <span class="pick-score">9.5</span>
            <span class="pick-score-label">/ 10</span>
          </div>
        </a>
        <a href="/reviews/nursing-com-review" class="pick-row">
          <div class="pick-rank">#2</div>
          <div class="pick-body">
            <div class="pick-top">
              <span class="pick-name">Nursing.com</span>
              <span class="badge badge-indigo">Best for Visual Learners</span>
            </div>
            <p class="pick-desc">Video-based learning with a strong nursing community and adaptive paths.</p>
          </div>
          <div class="pick-right">
            <span class="pick-score">9.0</span>
            <span class="pick-score-label">/ 10</span>
          </div>
        </a>
        <a href="/reviews/archer-review-nclex" class="pick-row">
          <div class="pick-rank">#3</div>
          <div class="pick-body">
            <div class="pick-top">
              <span class="pick-name">Archer Review</span>
              <span class="badge badge-green">Best Value</span>
            </div>
            <p class="pick-desc">High-quality question bank at a lower price point. Strong pass rate predictor.</p>
          </div>
          <div class="pick-right">
            <span class="pick-score">8.5</span>
            <span class="pick-score-label">/ 10</span>
          </div>
        </a>
      </div>
      <div class="picks-cta">
        <a href="/nclex">See all 5 courses compared →</a>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why-section page-wrap">
    <div class="why-grid">
      <div class="why-text">
        <div class="section-label">Why NurseSynapse</div>
        <h2>Real clinical experience behind every word</h2>
        <p>Most nursing resource sites are run by content agencies. NurseSynapse is different — it's built by a working RN who uses these tools, took these exams, and knows what actually matters at the bedside.</p>
        <p>Affiliate links are clearly disclosed. Sponsored content doesn't exist here. Just honest assessments from someone who's been there.</p>
        <a href="/about" class="btn-ghost" style="display:inline-block;margin-top:8px;">About us →</a>
      </div>
      <div class="why-cards">
        <div class="why-card">
          <span class="why-icon">🩺</span>
          <h3>Working RN</h3>
          <p>Real clinical experience — not a content farm or SEO agency.</p>
        </div>
        <div class="why-card">
          <span class="why-icon">🔍</span>
          <h3>Independent reviews</h3>
          <p>No paid placements. Rankings based on merit only.</p>
        </div>
        <div class="why-card">
          <span class="why-icon">⚡</span>
          <h3>Always current</h3>
          <p>Updated as tools and courses change. No stale information.</p>
        </div>
        <div class="why-card">
          <span class="why-icon">💡</span>
          <h3>AI-forward</h3>
          <p>Covering emerging healthcare AI before anyone else.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 100px 24px 80px;
  }
  .hero-inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
  .hero-glow {
    position: absolute;
    top: -100px; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 400px;
    background: radial-gradient(ellipse, rgba(13,148,136,0.15) 0%, rgba(99,102,241,0.1) 50%, transparent 70%);
    pointer-events: none;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(20,184,166,0.1);
    border: 1px solid rgba(20,184,166,0.25);
    color: var(--teal);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .hero h1 { margin-bottom: 20px; }
  .gradient-text {
    background: linear-gradient(135deg, #14b8a6, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub { font-size: 18px; color: var(--text-muted); max-width: 52ch; margin: 0 auto 36px; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 48px; }
  .btn-primary {
    background: linear-gradient(135deg, #0d9488, #6366f1);
    color: white;
    padding: 13px 28px;
    border-radius: 9px;
    font-weight: 600;
    font-size: 15px;
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; color: white; }
  .btn-ghost {
    background: var(--surface2);
    color: var(--text-muted);
    border: 1px solid var(--border-light);
    padding: 13px 28px;
    border-radius: 9px;
    font-weight: 600;
    font-size: 15px;
    transition: border-color 0.15s, color 0.15s;
  }
  .btn-ghost:hover { border-color: var(--teal); color: var(--text); }
  .hero-stats { display: flex; align-items: center; justify-content: center; gap: 28px; }
  .stat { display: flex; flex-direction: column; align-items: center; }
  .stat-num { font-size: 22px; font-weight: 800; background: linear-gradient(135deg, #14b8a6, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .stat-label { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .stat-divider { width: 1px; height: 32px; background: var(--border); }

  /* SECTIONS */
  .section-label { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal); margin-bottom: 10px; }
  .section-title { color: var(--text); margin-bottom: 32px; }

  /* FEATURES */
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s, box-shadow 0.15s;
    color: var(--text);
  }
  .feature-card:hover:not(.coming) { border-color: var(--border-light); box-shadow: 0 0 0 1px rgba(20,184,166,0.15), 0 8px 32px rgba(0,0,0,0.3); }
  .feature-card.coming { opacity: 0.6; cursor: default; }
  .feature-icon { font-size: 28px; }
  .feature-card h3 { font-size: 17px; margin: 0; }
  .feature-card p { color: var(--text-muted); font-size: 14px; line-height: 1.6; flex: 1; margin: 0; }
  .feature-link { color: var(--teal); font-size: 13px; font-weight: 600; margin-top: 4px; }

  /* PICKS */
  .picks-section { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .picks-list { display: flex; flex-direction: column; gap: 12px; }
  .pick-row {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    color: var(--text);
    transition: border-color 0.15s;
  }
  .pick-row:hover { border-color: var(--teal); }
  .pick-rank { font-size: 22px; font-weight: 800; color: var(--text-dim); min-width: 36px; }
  .pick-body { flex: 1; }
  .pick-top { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap; }
  .pick-name { font-weight: 700; font-size: 16px; }
  .pick-desc { color: var(--text-muted); font-size: 14px; margin: 0; }
  .pick-right { display: flex; align-items: baseline; gap: 2px; }
  .pick-score { font-size: 28px; font-weight: 800; background: linear-gradient(135deg, #14b8a6, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .pick-score-label { font-size: 13px; color: var(--text-dim); }
  .picks-cta { margin-top: 20px; text-align: center; }
  .picks-cta a { color: var(--teal); font-size: 14px; font-weight: 600; }

  /* WHY */
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .why-text p { color: var(--text-muted); font-size: 15px; line-height: 1.75; margin-bottom: 14px; }
  .why-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .why-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
  .why-icon { font-size: 22px; display: block; margin-bottom: 10px; }
  .why-card h3 { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
  .why-card p { color: var(--text-muted); font-size: 13px; line-height: 1.6; margin: 0; }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: 16px; }
  }
</style>
